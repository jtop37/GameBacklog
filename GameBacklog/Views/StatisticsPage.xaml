<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GameBacklog.ViewModels"
             x:Class="GameBacklog.Views.StatisticsPage"
             x:DataType="vm:StatisticsViewModel"
             Title="Statistics">

    <ContentPage.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
        </Style>
        <Style x:Key="TileValue" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="TileCaption" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Style="{StaticResource Tile}">
                    <VerticalStackLayout>
                        <Label Text="{Binding OwnedCount}" Style="{StaticResource TileValue}" />
                        <Label Text="Owned games" Style="{StaticResource TileCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Tile}">
                    <VerticalStackLayout>
                        <Label Text="{Binding TotalPlaytime}" Style="{StaticResource TileValue}" />
                        <Label Text="Total playtime" Style="{StaticResource TileCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Tile}">
                    <VerticalStackLayout>
                        <Label Text="{Binding AverageRating}" Style="{StaticResource TileValue}" />
                        <Label Text="Average rating" Style="{StaticResource TileCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Achievements}" Style="{StaticResource TileValue}" />
                        <Label Text="Achievements unlocked" Style="{StaticResource TileCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Tile}">
                <VerticalStackLayout>
                    <Label Text="{Binding MostPlayed}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Most played" Style="{StaticResource TileCaption}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="By status" FontSize="20" FontAttributes="Bold" Margin="0,8,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding StatusCounts}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatusCount">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Label}" />
                            <Label Grid.Column="1" Text="{Binding Count}" FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
