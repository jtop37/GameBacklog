<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GameBacklog.Models"
             xmlns:vm="clr-namespace:GameBacklog.ViewModels"
             x:Class="GameBacklog.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Library">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add game" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
    <HorizontalStackLayout Padding="16,8,16,0" Spacing="8">
        <Label Text="Sort by" VerticalOptions="Center" />
        <Picker ItemsSource="{Binding SortOptions}"
                SelectedIndex="{Binding SortIndex}"
                WidthRequest="170" />
        <Label Text="Status" VerticalOptions="Center" Margin="12,0,0,0" />
        <Picker ItemsSource="{Binding FilterOptions}"
                SelectedIndex="{Binding FilterIndex}"
                WidthRequest="170" />
    </HorizontalStackLayout>

    <CollectionView x:Name="GamesList"
                    Grid.Row="1"
                    ItemsSource="{Binding Games}"
                    SelectionMode="Single"
                    SelectionChanged="OnGameSelected"
                    Margin="16,8">
        <CollectionView.EmptyView>
            <VerticalStackLayout VerticalOptions="Center" Spacing="8" Padding="32">
                <Label Text="Your library is empty"
                       FontSize="20"
                       HorizontalTextAlignment="Center" />
                <Label Text="Add the first game to start tracking your backlog."
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Game">
                <Border Margin="0,6"
                        Padding="12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                    <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="14">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                WidthRequest="72"
                                HeightRequest="96"
                                BackgroundColor="{StaticResource Primary}">
                            <Grid>
                                <Label Text="{Binding Initial}"
                                       FontSize="30"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Subtitle}" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding StatusText}" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding RatingText}" HorizontalTextAlignment="End" />
                            <Label Text="{Binding AchievementSummary}"
                                   TextColor="{StaticResource Gray500}"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    </Grid>

</ContentPage>
