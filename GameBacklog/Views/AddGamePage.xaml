<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GameBacklog.ViewModels"
             x:Class="GameBacklog.Views.AddGamePage"
             x:DataType="vm:AddGameViewModel"
             Title="Add game">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="560">
            <VerticalStackLayout Spacing="4">
                <Label Text="Title" FontAttributes="Bold" />
                <Entry Text="{Binding Title}" Placeholder="Game title" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Platform" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Platforms}"
                        SelectedItem="{Binding Platform}"
                        Title="Select platform" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Release year" FontAttributes="Bold" />
                <Entry Text="{Binding YearText}" Keyboard="Numeric" MaxLength="4" />
            </VerticalStackLayout>

            <Button Text="Save game" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
